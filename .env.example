# ==========================================
# VARIABLES D'ENVIRONNEMENT - BACKEND JULEE
# ==========================================
# Copiez ce fichier en .env et adaptez les valeurs

# Base de données MySQL
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/julee"

# Port du serveur backend
PORT=3001

# Environnement
NODE_ENV=production

# Clé secrète JWT — générer avec : openssl rand -base64 32
JWT_SECRET=VUX/4gC0Kjl5qoEto85uPrA1LjKWrqp2rMikfAaeBCE=

# Origines autorisées (adresse IP + port du frontend)
CORS_ORIGINS=http://IP_SERVEUR:3002

# Compte administrateur initial (créé automatiquement au premier démarrage)
ADMIN_EMAIL=admin@julee.local
ADMIN_PASSWORD=JuleeAdmin@2024!

